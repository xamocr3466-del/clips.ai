# Copy to .env and keep .env private. Run uvicorn with --env-file .env.
PUBLIC_URL=http://127.0.0.1:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth authorized redirect URI: http://127.0.0.1:8000/auth/callback
# Existing Stripe subscribers only; preserve these credentials to manage and receive their events.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
# New INR payments: Razorpay merchant with dynamic QR enabled and a public HTTPS webhook.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# 0 removes the application cap; disk/hosting limits still apply.
CLIPSTUDIO_MAX_BYTES=0
CLIPSTUDIO_MAX_DURATION=0
# Default uses CPU. NVIDIA GPU needs matching CUDA/cuDNN libraries.
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Private local use ONLY. Leave 0 for Google-only accounts and paid access.
CLIPSTUDIO_LOCAL_MODE=0
